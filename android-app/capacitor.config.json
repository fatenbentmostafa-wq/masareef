{
  "appId": "com.kareem.masareef",
  "appName": "مصاريف البيت",
  "webDir": "www",
  "server": {
    "url": "https://fatenbentmostafa-wq.github.io/masareef/",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#08130F",
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#08130F"
    }
  }
}
